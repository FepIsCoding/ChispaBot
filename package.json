{
  "name": "chispa-connect",
  "version": "1.1.1",
  "description": "Chispa Connect",
  "author": "Fep",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fep.chispaconnect",
    "productName": "Chispa Connect",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Chispa-Connect.${ext}",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Chispa-Connect-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "FepIsCoding",
      "repo": "ChispaBot",
      "releaseType": "release"
    },
    "files": [
      "main.js",
      "app/**/*",
      "package.json"
    ]
  }
}